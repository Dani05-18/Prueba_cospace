# Cadena de conexión a PostgreSQL en Supabase (Transaction Pooler - puerto 6543 con ?pgbouncer=true)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Cadena de conexión directa a Supabase para migraciones (Session Pooler - puerto 5432)
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Secretos para firmar tokens JWT (generar con: openssl rand -base64 32)
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""

# Tiempos de expiración de los tokens
ACCESS_TOKEN_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN="7d"